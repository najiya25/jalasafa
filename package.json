{
  "name": "jalsafa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "JalSafa - Find public toilets & drinking water near you (one-city civic tech prototype)",
  "engines": { "node": ">=18" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "seed": "tsx server/seed-cli.ts",
    "qa": "node scripts/qa.mjs",
    "filter-test": "node scripts/filter-test.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
